                <run bold='true'><![CDATA[<[federated.1aamvkw0llanvf18oi2oo0xkf8j6].[none:lead_time_days:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#757575'>Service Level — assumption:&#9;</run>
                <run bold='true'><![CDATA[<[federated.1aamvkw0llanvf18oi2oo0xkf8j6].[none:service_level:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#757575'>Model:&#9;</run>
                <run bold='true'><![CDATA[<[federated.1aamvkw0llanvf18oi2oo0xkf8j6].[attr:model:nk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#757575'>Store:&#9;</run>
                <run bold='true'><![CDATA[<[federated.1aamvkw0llanvf18oi2oo0xkf8j6].[attr:store_id:qk]>]]></run>
                <run>Æ&#10;</run>
                <run fontcolor='#757575'>Avg. Scenario Safety Stock (units):	</run>
                <run bold='true'><![CDATA[<[federated.1aamvkw0llanvf18oi2oo0xkf8j6].[avg:safety_stock:qk]>]]></run>
                <run>Æ&#10;</run>
